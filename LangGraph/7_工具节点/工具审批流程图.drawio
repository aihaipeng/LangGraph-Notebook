        </mxCell>
        <mxCell id="n_start" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#334155;fontSize=13;" value="开始：用户消息" vertex="1">
          <mxGeometry height="40" width="240" x="290" y="70" as="geometry" />
        </mxCell>
        <mxCell id="n_llm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=1.5;fontSize=12;" value="llm_node（模型节点）&#xa;读取全部历史 → 调模型得到 ai_msg&#xa;ai_msg 可能携带 tool_calls" vertex="1">
          <mxGeometry height="80" width="340" x="240" y="135" as="geometry" />
        </mxCell>
        <mxCell id="n_tool1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.5;fontSize=12;" value="tool_node · 阶段一：收齐审批决策&#xa;遍历 ai_msg.tool_calls（可能多个）&#xa;免审批工具 → 放行标记（NEVER_ASK）&#xa;待审批工具 → interrupt(payload)&#xa;payload = { name, args }" vertex="1">
          <mxGeometry height="115" width="340" x="240" y="240" as="geometry" />
        </mxCell>
        <mxCell id="n_int" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;dashed=1;dashPattern=6 4;fontSize=12;" value="raise GraphInterrupt&#xa;图挂起 · 状态落盘 · 返回 __interrupt__" vertex="1">
          <mxGeometry height="68" width="300" x="260" y="380" as="geometry" />
        </mxCell>
        <mxCell id="n_appr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fed7aa;strokeColor=#ea580c;strokeWidth=3;fontSize=12;" value="★ 人 工 审 批 ★&#xa;查看 payload：要调什么工具（name）、什么参数（args）&#xa;决策：① 同意　② 同意并改参数（edit）　③ 拒绝（带原因）&#xa;组装恢复值 → Command(resume=决策值)&#xa;协议：True / {approved, args, reason}（恢复值须显式转 bool）&#xa;⚠ 字符串 &quot;False&quot; 是真值，会被判成同意！" vertex="1">
          <mxGeometry height="170" width="420" x="200" y="510" as="geometry" />
        </mxCell>
        <mxCell id="n_invoke" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontSize=12;" value="graph.invoke(Command(resume=决策), config)" vertex="1">
          <mxGeometry height="40" width="300" x="260" y="695" as="geometry" />
        </mxCell>
        <mxCell id="n_tool2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.5;fontSize=12;" value="tool_node 从头重跑（同一 super-step）&#xa;阶段一 interrupt() 按顺序依次返回缓存恢复值&#xa;（不再暂停 —— 工具严格一次执行的基础）" vertex="1">
          <mxGeometry height="95" width="340" x="240" y="810" as="geometry" />
        </mxCell>
        <mxCell id="n_dec" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontSize=12;fontStyle=1;rounded=1;" value="恢复值&#xa;approved？" vertex="1">
          <mxGeometry height="110" width="180" x="320" y="920" as="geometry" />
        </mxCell>
        <mxCell id="n_ok" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.5;fontSize=12;" value="执行工具：tool.invoke(args)&#xa;args = 恢复值带的新参数（若有）" vertex="1">
          <mxGeometry height="76" width="250" x="80" y="1070" as="geometry" />
        </mxCell>
        <mxCell id="n_no" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dc2626;strokeWidth=1.5;fontSize=12;" value="不执行，回填拒绝文案：&#xa;用户拒绝执行（reason），请直接回答" vertex="1">
          <mxGeometry height="76" width="250" x="490" y="1070" as="geometry" />
        </mxCell>
        <mxCell id="n_merge" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;fontSize=12;" value="ToolMessage 回填（tool_call_id = tc.id）→ Command(goto=llm_node）&#xa;数据回流 + 控制回流 —— 模型看到工具应答 / 拒绝文案，再推理" vertex="1">
          <mxGeometry height="64" width="500" x="160" y="1185" as="geometry" />
