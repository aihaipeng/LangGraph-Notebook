        <mxCell id="b2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#9a3412;" value="阶段② 人工审批 ★ 核心环节" vertex="1">
          <mxGeometry height="290" width="680" x="70" y="480" as="geometry" />
